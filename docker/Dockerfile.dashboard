# Image for the Streamlit showcase dashboard.
# Build context is the repository root: docker build -f docker/Dockerfile.dashboard .
#
# The dashboard is stateless: it talks to the prediction API over HTTP (set
# API_BASE_URL) and bundles only the static showcase artifacts (model cards,
# fairness reports, drift reports, SHAP plots, zone lookup). No models or MLflow
# are required.

# --- Builder: install dashboard dependencies into a venv ----------------------
# The official Python image through Amazon ECR Public, which AWS builds can pull
# without Docker Hub's anonymous rate limit.
FROM public.ecr.aws/docker/library/python:3.11-slim AS builder

# uv installs the exact versions in uv.lock (hash-checked) into /opt/venv with
# the image's own Python. --frozen fails the build if the lock is out of date.
COPY --from=ghcr.io/astral-sh/uv:0.12.1 /uv /bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_NO_CACHE=1

WORKDIR /app
# Only the dashboard dependency group: UI, plotting and HTTP, no ML stack.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --only-group dashboard --no-install-project

# --- Runtime: copy venv + app + static artifacts ------------------------------
FROM public.ecr.aws/docker/library/python:3.11-slim AS runtime

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONFAULTHANDLER=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    API_BASE_URL=http://localhost:8000

WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY dashboard ./dashboard

# Static showcase artifacts rendered by the Responsible AI and forecast views.
COPY docs/model_cards ./docs/model_cards
COPY artifacts/responsible ./artifacts/responsible
COPY artifacts/drift ./artifacts/drift
COPY data/raw/taxi_zone_lookup.csv ./data/raw/taxi_zone_lookup.csv

# Run as an unprivileged user, like the API image.
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin app \
    && chown -R app:app /app
USER app

EXPOSE 8501

# Streamlit serves on 8501; the ALB health check hits Streamlit's health path.
CMD ["streamlit", "run", "dashboard/app.py", \
     "--server.port=8501", "--server.address=0.0.0.0", \
     "--server.headless=true", "--browser.gatherUsageStats=false"]
