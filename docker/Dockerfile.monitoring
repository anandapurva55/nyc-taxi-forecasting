# Image for the SageMaker Processing monitoring jobs.
#
# The default entrypoint runs scripts/monitoring/run_drift_job.py: it compares
# captured prediction records in S3 against the training split baked into this
# image, writes drift_metrics.json and publishes drift metrics to CloudWatch.
# The live accuracy job overrides the entrypoint with run_performance_job.py.
#
# Build for SageMaker (x86_64) from the repository root:
#   docker buildx build --platform linux/amd64 -f docker/Dockerfile.monitoring -t <ecr-repo>:monitoring --push .

# The official Python image through Amazon ECR Public, which AWS builds can pull
# without Docker Hub's anonymous rate limit.
FROM public.ecr.aws/docker/library/python:3.15-slim AS builder

# uv installs the exact versions in uv.lock (hash-checked) into /opt/venv with
# the image's own Python. --frozen fails the build if the lock is out of date.
COPY --from=ghcr.io/astral-sh/uv:0.12.1 /uv /bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_NO_CACHE=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# Runtime dependencies plus the monitoring group (boto3).
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --group monitoring --no-install-project

FROM public.ecr.aws/docker/library/python:3.15-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    MLFLOW_DISABLE_AGENT_HINT=1

WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY src ./src
COPY config ./config
COPY scripts ./scripts

# Reference distributions for drift comparison.
COPY data/features/demand_train.parquet ./data/features/demand_train.parquet
COPY data/features/fare_train.parquet ./data/features/fare_train.parquet

ENTRYPOINT ["python3", "scripts/monitoring/run_drift_job.py"]
